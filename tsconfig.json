{
  "include": ["client/src/**/*", "packages/**/*", "server/**/*", "shared/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@adster/checklists": ["./packages/checklists/src/index.ts"],
      "@adster/schema-core": ["./packages/schema-core/src/index.ts"],
      "@adster/sitemap-core": ["./packages/sitemap-core/src/index.ts"],
      "@adster/toolbox-config": ["./packages/config/src/index.ts"],
      "@adster/toolbox-ui": ["./packages/ui/src/index.ts"],
      "@adster/wireframe-core": ["./packages/wireframe-core/src/index.ts"]
    }
  }
}
